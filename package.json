{
  "name": "skills-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @skills-demo/client-react dev",
    "dev:server": "pnpm --filter @skills-demo/server dev",
    "dev:fs": "VITE_SERVER_URL=ws://localhost:4000/ws VITE_API_URL=http://localhost:4000 turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.tooling.json",
    "test": "turbo run test",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "gates": "node tools/arch/gates/run.mts",
    "gate:fast": "pnpm gates && pnpm lint && pnpm typecheck && pnpm visual:check && pnpm perf:check",
    "gate:full": "pnpm gate:fast && pnpm test && pnpm build && pnpm coverage",
    "coverage": "node tools/coverage/run.mts",
    "coverage:gaps": "node tools/coverage/gaps.mts",
    "mutation-check": "node tools/coverage/mutation-check.mts",
    "visual": "pnpm --dir packages/client-react exec playwright test --config tests/visual/playwright.config.ts",
    "visual:update": "pnpm --dir packages/client-react exec playwright test --config tests/visual/playwright.config.ts --update-snapshots=all",
    "visual:jitter": "node tools/visual/jitter.mts",
    "visual:check": "node tools/visual/check-pin.mts && pnpm --dir packages/client-react run typecheck:visual",
    "perf:check": "node tools/perf/check-animations.mts",
    "perf:motion-audit": "node tools/perf/motion-audit.mts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/utils": "^8.70.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.5.0",
    "turbo": "^2.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "playwright": "1.63.0"
  }
}
