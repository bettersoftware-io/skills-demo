{
  "description": "Architecture gates: judge each written file, and refuse to finish on a red gate.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/arch/hooks/after-edit.mts",
            "statusMessage": "Checking architecture rules",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/arch/hooks/before-stop.mts",
            "statusMessage": "Running the gate",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/agent-workflow/hooks/split-outward-commands.mts",
            "statusMessage": "Checking how the command is joined",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/agent-workflow/hooks/changelog-due.mts",
            "statusMessage": "Checking the changelog",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
